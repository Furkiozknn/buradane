# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/

# Env files, every variant and at every depth. The bare `.env` rule left
# backend/.env.production, .env.local and .env.prod committable, and
# docs/backend-ortam-degiskenleri.md tells operators to put
# BURADANE_ADMIN_TOKEN and BURADANE_JWT_SECRET in exactly such a file - so
# one `git add .` would have published them to a public repository. The
# negation keeps the checked-in template visible.
.env
.env.*
!.env.example

# Node (frontend)
node_modules/
.next/
# Copied from node_modules by scripts/copy-maplibre-worker.mjs at pre(dev|build)
frontend/public/maplibre/

# Overpass response cache - a local build artifact, not source. Delete it to
# force scripts/fetch_demo_data.py to re-pull from the API.
.overpass-cache/

# Community contributions written by the running demo. The committed dataset
# is the OSM snapshot; runtime user submissions are local state.
frontend/data/contributions.json

# OS
.DS_Store
Thumbs.db
